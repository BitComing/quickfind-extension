# Browser automation output（仅忽略截图等临时产物；回归用例在 tests/ 入库）
.playwright-cli/

# 本机产物整目录不入库：audit 探针、过程截图、sync 存储快照（可能是个人数据）。
# 回归用例在 tests/，产物在 .output/，都不受影响。
output/

# Local backup of the corrupted repo (can be deleted once verified)
.git.bak/

# Agent workspace data
.workbuddy/

# Build output & dependencies
node_modules/
.output/
.wxt/
stats.html

# 私有素材与私有服务端：只留在本机，不进公开仓库。
# public/pay/ 是收款码与联系码（含个人微信账号），license-server/ 是发卡服务端源码；
# 选项页读不到图片时会自动隐藏整块扫码区域（见 options/main.ts）。
license-server/
public/pay/

# Python 脚本的字节码缓存
__pycache__/
