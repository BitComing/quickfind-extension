{
  "name": "quickfind",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "选中文字后，在文字末端快速打开常用搜索引擎。",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "node build.mjs",
    "build:firefox": "node build.mjs -b firefox",
    "build:raw": "wxt build",
    "zip": "wxt zip",
    "compile": "tsc --noEmit",
    "typecheck": "node scripts/typecheck.mjs",
    "typecheck:debt": "node scripts/typecheck.mjs --debt",
    "typecheck:baseline": "node scripts/typecheck.mjs --update-baseline",
    "check": "node scripts/typecheck.mjs --debt --fail-on-regression"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.9",
    "typescript": "^7.0.2",
    "wxt": "^0.21.4"
  },
  "overrides": {
    "vite": "^7.0.0"
  }
}
